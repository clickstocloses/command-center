# Copy to .env.local and fill in. Names only here, never values.
# Each variable is listed under the Phase 0 part that first needs it (see plans/).

# Part A: app
NEXT_PUBLIC_APP_URL=            # http://localhost:3000 locally, the Vercel URL in production

# Part B: Supabase (from the Supabase project settings, API page)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only. Never import into a client component

# Part D: HighLevel Marketplace app (from the app's settings in the HighLevel developer portal)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=              # server only
GHL_SHARED_SECRET=              # server only. Decrypts the Custom Page SSO payload
GHL_TOKEN_ENCRYPTION_KEY=       # server only. 32 random bytes, base64. Encrypts OAuth tokens at rest

# Part F: background jobs and AI
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
ANTHROPIC_API_KEY=              # server only

# Later phases
FATHOM_API_KEY=
FIRECRAWL_API_KEY=
